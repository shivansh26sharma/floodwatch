# Real data is never committed — it is downloaded per the README.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Fixtures ARE committed so the pipeline runs on a fresh clone.
!data/fixtures/

# Generated results — regenerated by the pipeline, never committed.
# (outputs/figures/architecture.svg IS committed: it is a hand-made
#  deliverable for the report, not a build artifact.)
outputs/models/*
outputs/reports/*
outputs/figures/*.png
!outputs/figures/architecture.svg

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
