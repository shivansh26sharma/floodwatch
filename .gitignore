# Real data is never committed — it is downloaded per the README.
data/raw/*
data/interim/*
data/processed/*
# ...except the SCOPED real demo slice. Small enough to commit and to
# train on a 1GB host, so a deploy serves real numbers without the ~32MB
# of raw ERA5/GloFAS/DFO sources. The full frame would OOM the free tier.
# DFO is CC0; ERA5/GloFAS via Open-Meteo are free for non-commercial use
# with attribution. Cite all three.
!data/processed/demo_dataset.parquet
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Fixtures ARE committed so the pipeline runs on a fresh clone.
!data/fixtures/

outputs/models/*.pkl
outputs/models/*.json
outputs/figures/*.png

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.DS_Store

# Live conditions are fetched on demand, never committed.
data/live/

# Per-row forecast predictions: 18-28 MB each, regenerated by
# `python -m src.models.forecast`. The comparison tables and the matched
# comparison in the same folder are what the report cites; these are the
# raw rows behind them and have no business in git. Pushing them is what
# made GitHub reject the push with a 500.
outputs/reports/forecast_preds_*.csv

# Scratch copies kept beside real artefacts during development.
*.old
outputs/_fc_backup/
